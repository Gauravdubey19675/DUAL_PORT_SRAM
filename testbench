    wr_en_1 = 1;
    wr_en_2 = 0;
    rd_en_1 = 0;
    rd_en_2 = 1;
    address_1 = 10'd8;
    address_2 = 10'd16;
    data_in_1 = 10'd100;#10;
    
    
    wr_en_1 = 0;
    wr_en_2 = 0;
    rd_en_1 = 1;
    rd_en_2 = 1;
