    rd_en_2 = 0;
    wr_en_2 = 1;
    rd_en_1 = 0;
    data_in_1 = 8'd20;
    data_in_2 = 8'd24;
    address_1 = 10'd11;
    address_2 = 10'd12;

    #10;
    reset=1'b0;
    wr_en_1 = 1;
    rd_en_2 = 0;
    wr_en_2 = 1;
    rd_en_1 = 0;
    data_in_2 = 8'd84;
    address_1 = 10'd7;
    address_2 = 10'd11;

    #10;
    
     wr_en_1 = 1;
    rd_en_2 = 0;
    wr_en_2 = 0;
    rd_en_1 = 1;
    data_in_2 = 8'd84;
    address_1 = 10'd7;
    address_2 = 10'd11;

    #10;
   

    wr_en_1 = 0;
    wr_en_2 = 0;
    rd_en_1 = 1;
    rd_en_2 = 1;
    address_1 = 10'd7;
    address_2 = 10'd11;

